#!/bin/sh
#
# Refuse the commit when docs/ has fallen behind the Obsidian vault, so the
# mirrored design notes cannot silently go stale.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks
# Bypass once with:              git commit --no-verify
#
# The check is skipped rather than failed when it cannot run (no vault on this
# machine, no PowerShell, script missing). A commit should never be blocked by
# a check that is simply unavailable.

repo_root=$(git rev-parse --show-toplevel) || exit 0
script="$repo_root/scripts/sync-docs.ps1"

[ -f "$script" ] || exit 0

ps_exe=""
for candidate in powershell.exe pwsh.exe pwsh powershell; do
    if command -v "$candidate" >/dev/null 2>&1; then
        ps_exe="$candidate"
        break
    fi
done

if [ -z "$ps_exe" ]; then
    echo "pre-commit: no PowerShell found, skipping the docs staleness check." >&2
    exit 0
fi

"$ps_exe" -NoProfile -ExecutionPolicy Bypass -File "$script" -Check
status=$?

case "$status" in
    0)
        exit 0
        ;;
    1)
        echo "" >&2
        echo "pre-commit: docs/ is behind the Obsidian vault." >&2
        echo "  Sync it:  .\scripts\sync-docs.ps1" >&2
        echo "  then stage the result and commit again." >&2
        echo "  To commit anyway:  git commit --no-verify" >&2
        exit 1
        ;;
    2)
        echo "pre-commit: vault not found on this machine, skipping the docs check." >&2
        exit 0
        ;;
    *)
        echo "pre-commit: docs check exited unexpectedly ($status), allowing the commit." >&2
        exit 0
        ;;
esac
